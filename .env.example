# ---------- Telegram ----------
BOT_TOKEN_CLIENT=
BOT_TOKEN_ADMIN=

# Super-admins (owners), comma-separated Telegram IDs.
# Ordinary admins are invited from the bot itself: /add_admin @username
ADMIN_IDS=123456789,987654321

# ---------- Postgres ----------
# These three are consumed by the postgres container itself.
POSTGRES_DB=corruption
POSTGRES_USER=corruption
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Application DSN. Host must be the compose service name `postgres`,
# and the credentials must match the three variables above.
POSTGRES_DSN=postgresql+asyncpg://corruption:change-me-to-a-long-random-string@postgres:5432/corruption

# ---------- Redis ----------
# Celery broker/backend and aiogram FSM storage. Host = compose service name `redis`.
REDIS_URL=redis://redis:6379/0

# ---------- Runtime ----------
TZ=Asia/Tashkent
